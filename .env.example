# ascii-player environment variables
# Copy to .env and adjust as needed

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Default video width in characters
DEFAULT_WIDTH=80

# Default FPS limit
DEFAULT_FPS=30

# Cache directory for downloaded YouTube videos
CACHE_DIR=/tmp/ascii-cache

# Audio device (ALSA device string)
AUDIO_DEVICE=default